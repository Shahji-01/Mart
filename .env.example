# ==============================================================================
# Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace the placeholders with your actual secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Format: postgres://username:password@host:port/database_name
# NEVER hardcode this string in the application code.
DATABASE_URL=postgres://user:your_secure_password@localhost:5432/mart
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Must be a cryptographically secure random string of at least 32 characters.
# DO NOT use dictionary words or default placeholders in production.
SESSION_SECRET=your_32_character_minimum_secure_random_string_here
CRON_SECRET=your_secure_cron_trigger_secret_here

# ------------------------------------------------------------------------------
# Payment Provider (Razorpay)
# ------------------------------------------------------------------------------
# Options: "simulated" or "razorpay"
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# Search Engine (Meilisearch)
# ------------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key_here

# ------------------------------------------------------------------------------
# Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ------------------------------------------------------------------------------
# Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ------------------------------------------------------------------------------
# Frontend Variables (Public)
# ------------------------------------------------------------------------------
# Only variables starting with VITE_ are exposed to the client-side code.
# DO NOT put sensitive secrets (passwords, private API keys) in VITE_ variables.
VITE_API_URL=http://localhost:5000
VITE_SENTRY_DSN=your_sentry_dsn_here

# ------------------------------------------------------------------------------
# Network / Proxy Options
# ------------------------------------------------------------------------------
# Set to 1 if deploying behind a reverse proxy (like AWS ALB or Nginx)
# TRUST_PROXY=1
