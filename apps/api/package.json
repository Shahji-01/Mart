    "@workspace/database": "workspace:*",
    "@workspace/validation": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.8.0",
    "drizzle-orm": "catalog:",
