# Copy this file to `.env` (in apps/api/) and fill in real values.
# The API loads apps/api/.env automatically on startup. Values already set on
# the command line (e.g. by the root `dev:api` script) take precedence, so
# DATABASE_URL / SESSION_SECRET don't need to be here for local dev.
#
# NEVER commit the real .env file (it is git-ignored).

# ── Razorpay (online payments) ───────────────────────────────────────────────
# Get these from Razorpay Dashboard → Settings → API Keys.
# When BOTH are set, online checkout automatically switches to Razorpay.
# Use rzp_test_... keys while testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook signing secret (Razorpay Dashboard → Settings → Webhooks). Optional;
# enables out-of-band payment reconciliation at POST /api/payments/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shankeshwartraders.in

# ── Optional overrides ───────────────────────────────────────────────────────
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mart
# SESSION_SECRET=a-strong-random-secret-at-least-32-characters-long
# PAYMENT_PROVIDER=simulated   # "simulated" (default) | "none"
# ALLOWED_ORIGIN=http://localhost:3000
