{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/web run build && cd apps/api && node build.mjs",
  "outputDirectory": "apps/web/dist/public",

  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 0 * * *"
    }
  ]
}
